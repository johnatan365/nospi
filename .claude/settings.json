{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "Edit",
      "Write",
      "NotebookEdit",
      "TodoWrite",
      "WebFetch",
      "WebSearch",
      "Task",
      "Bash",
      "mcp__Supabase",
      "mcp__github",
      "mcp__Facebook",
      "mcp__Google_Drive",
      "mcp__Higgsfield",
      "mcp__Adobe_for_creativity",
      "mcp__Claude_Docs",
      "mcp__Claude_Code_Remote"
    ],
    "deny": [
      "Bash(rm -rf /*)",
      "Bash(rm -rf ~*)",
      "Bash(git push --force*)",
      "Bash(git push -f*)"
    ]
  }
}
